NODE_ENV=production
PORT=3000
GLOBAL_PREFIX=api
API_VERSION=v1
APP_NAME="Vehicle Information System API Gateway"

CORS_ORIGIN=https://vis.enterprise.com
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=100

DATABASE_URL=postgresql://vis_user:vis_password@postgres:5432/vis_db?schema=public
MONGODB_URI=mongodb://mongodb:27017/vis_db

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=vis-api-gateway-prod
KAFKA_GROUP_ID=vis-gateway-group-prod

MQTT_URL=mqtt://emqx:1883
MQTT_CLIENT_ID=vis-gateway-mqtt-prod

LOG_LEVEL=info
