# Production Environment Configuration
NODE_ENV=production
PORT=3000
GLOBAL_PREFIX=api
API_VERSION=v1

# Security & Secrets
JWT_SECRET=vis-prod-hyper-secure-jwt-secret-key-2026-very-long
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=12
CORS_ALLOWED_ORIGINS=https://fleet.enterprise.com,https://admin.enterprise.com

# Microservice Ports
AUTH_PORT=3001
USER_PORT=3002
FLEET_PORT=3003
VEHICLE_PORT=3004
TELEMETRY_PORT=3005
LOCATION_PORT=3006
TRIP_PORT=3007
DIAGNOSTICS_PORT=3008
DRIVER_BEHAVIOUR_PORT=3009
REMOTE_COMMAND_PORT=3010
OTA_PORT=3011
NOTIFICATION_PORT=3012
ANALYTICS_PORT=3013
REPORTING_PORT=3014
AUDIT_PORT=3015
ADMIN_PORT=3016

# Database Connections
DATABASE_URL=postgresql://vis_user:vis_secure_prod_password_2026@postgres:5432/vis_db?schema=public&connection_limit=50
MONGODB_URI=mongodb://mongo:27017/vis_telemetry_db?maxPoolSize=100
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=vis_redis_secure_password_2026
KAFKA_BROKERS=kafka:9092
MQTT_URL=mqtt://emqx:1883

# Observability
LOG_LEVEL=info
ENABLE_OTEL=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PROMETHEUS_PORT=9090
