NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api
API_VERSION=v1
APP_NAME="Vehicle Information System API Gateway"

CORS_ORIGIN=*
RATE_LIMIT_TTL=60000
RATE_LIMIT_LIMIT=1000

DATABASE_URL=postgresql://vis_user:vis_password@localhost:5432/vis_db?schema=public
MONGODB_URI=mongodb://localhost:27017/vis_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=vis-api-gateway-dev
KAFKA_GROUP_ID=vis-gateway-group-dev

MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=vis-gateway-mqtt-dev

LOG_LEVEL=debug
