# Staging Environment Configuration
NODE_ENV=staging
PORT=3000
GLOBAL_PREFIX=api
API_VERSION=v1

JWT_SECRET=vis-staging-secure-jwt-secret-key-2026
JWT_ACCESS_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d
BCRYPT_SALT_ROUNDS=10

DATABASE_URL=postgresql://vis_user:vis_staging_password@postgres:5432/vis_db_staging?schema=public
MONGODB_URI=mongodb://mongo:27017/vis_telemetry_staging
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BROKERS=kafka:9092
MQTT_URL=mqtt://emqx:1883
LOG_LEVEL=debug
