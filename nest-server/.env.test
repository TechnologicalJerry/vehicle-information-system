# Test Environment Configuration
NODE_ENV=test
PORT=3000
GLOBAL_PREFIX=api
API_VERSION=v1

JWT_SECRET=vis-test-secret-jwt-key
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=1d
BCRYPT_SALT_ROUNDS=4

DATABASE_URL=postgresql://vis_user:vis_password@localhost:5432/vis_test_db?schema=public
MONGODB_URI=mongodb://localhost:27017/vis_test_db
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BROKERS=localhost:9092
MQTT_URL=mqtt://localhost:1883
LOG_LEVEL=error
